<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        权限声明说明（最小化原则）：
        QUERY_ALL_PACKAGES：Android 11+ 需此权限才能枚举全部已安装应用，这是权限审计功能的前提。
        READ_EXTERNAL_STORAGE：读取存储中的 APK 文件进行静态扫描（仅 Android 12 及以下需要）。
        本应用不申请 INTERNET 权限——全部分析在本地完成，不存在任何数据上传通道。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!--
        POST_NOTIFICATIONS（Android 13+）：仅用于「新装应用自动体检」在发现高风险时
        发出本地通知。不发远程推送，通知内容全部在本地生成。
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
        守护模式相关权限：
        RECEIVE_BOOT_COMPLETED：开机后重排巡检任务并跑一次开机自检。
        FOREGROUND_SERVICE / FOREGROUND_SERVICE_SPECIAL_USE：守护模式的常驻通知
            （Android 14 起前台服务必须声明类型；本用途无法归入既有类型，故用 specialUse）。
        PACKAGE_USAGE_STATS：前台唤醒监听所需的特殊权限，**必须由用户在系统设置中手动授予**，
            应用无法自行申请。未授予时该通道自动跳过，其余功能不受影响。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <application
        android:name=".IceGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IceGuard">

        <activity
            android:name=".ui.home.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.audit.AuditActivity"
            android:exported="false"
            android:label="应用权限审计"
            android:parentActivityName=".ui.home.MainActivity"/>

        <activity
            android:name=".ui.apk.ApkScanActivity"
            android:exported="false"
            android:label="安装包扫描"
            android:parentActivityName=".ui.home.MainActivity"/>

        <activity
            android:name=".ui.guard.GuardCenterActivity"
            android:exported="false"
            android:label="守护中心"
            android:parentActivityName=".ui.home.MainActivity"/>

        <!-- 守护通道 1：新装 / 更新应用。系统广播，无需任何特殊权限 -->
        <receiver
            android:name=".core.monitor.InstallMonitorReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <action android:name="android.intent.action.PACKAGE_REPLACED"/>
                <data android:scheme="package"/>
            </intent-filter>
        </receiver>

        <!-- 守护通道 2：开机自检 -->
        <receiver
            android:name=".core.guard.BootGuardReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- 通知动作：承载「立即终止」按钮。限定包内广播，外部应用无法触发 -->
        <receiver
            android:name=".core.guard.GuardActionReceiver"
            android:exported="false"/>

        <!-- 守护通道 3 的载体：常驻前台服务 -->
        <service
            android:name=".core.guard.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_security_guard"/>
        </service>

        <!--
            守护通道 4：无障碍事件。只监听窗口状态变化、只读取包名。
            配置见 res/xml/accessibility_service_config.xml：
            canRetrieveWindowContent=false，且未声明 canPerformGestures，
            服务在能力上不可能读取屏幕内容或模拟点击。
        -->
        <service
            android:name=".core.guard.GuardAccessibilityService"
            android:exported="true"
            android:label="@string/guard_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!--
            Shizuku Provider：Shizuku API 的固定接入点。
            说明：该 provider 与 API 制品均为 Apache-2.0 官方制品，本应用并未内嵌
            Shizuku 应用本体；用户需自行安装 Shizuku 并通过「无线调试配对」授权。
        -->
        <activity
            android:name=".ui.privilege.PrivilegeGuideActivity"
            android:exported="false"
            android:label="权限授权与处置"
            android:parentActivityName=".ui.home.MainActivity"/>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>

</manifest>
